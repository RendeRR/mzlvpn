<?xml version="1.0" encoding="utf-8"?>
<!-- Breaker switch pictogram, OFF: the lever sits DOWN and is
     paper-colored. Layered shapes only — the widget-safe drawable
     tech (same family as widget_bg, which loads fine in launchers).
     Geometry is fixed-dp and centered: the widget lives in a 1x1
     cell, so the pictogram does not need to scale. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- housing -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/pribor_ink" />
            <corners android:radius="6dp" />
        </shape>
    </item>

    <!-- slot -->
    <item
        android:width="8dp"
        android:height="34dp"
        android:gravity="center">
        <shape android:shape="rectangle">
            <solid android:color="@color/pribor_paper_deep" />
            <corners android:radius="2dp" />
        </shape>
    </item>

    <!-- lever, down -->
    <item
        android:width="22dp"
        android:height="14dp"
        android:bottom="7dp"
        android:gravity="bottom|center_horizontal">
        <shape android:shape="rectangle">
            <solid android:color="@color/pribor_paper" />
            <stroke
                android:width="1dp"
                android:color="@color/pribor_ink" />
            <corners android:radius="2dp" />
        </shape>
    </item>
</layer-list>
