    <path
        android:fillColor="#15202B"
        android:strokeColor="#F4F1EA"
        android:strokeWidth="3"
        android:pathData="M14.5,1.5h33a13,13 0 0 1 13,13v33a13,13 0 0 1 -13,13h-33a13,13 0 0 1 -13,-13v-33a13,13 0 0 1 13,-13z" />
    <!-- slider guides: end stops -->
    <path
        android:fillColor="#F4F1EA"
        android:pathData="M8,21h3.5v20H8z" />
    <path
        android:fillColor="#F4F1EA"
        android:pathData="M50.5,21H54v20h-3.5z" />
