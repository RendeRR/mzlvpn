<?xml version="1.0" encoding="utf-8"?>
<!-- Breaker switch pictogram, ON: the lever sits UP and is signal
     orange. See widget_switch_off.xml for the construction notes. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- housing -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/pribor_ink" />
            <corners android:radius="6dp" />
        </shape>
    </item>

    <!-- slot -->
    <item
        android:width="8dp"
        android:height="34dp"
        android:gravity="center">
        <shape android:shape="rectangle">
            <solid android:color="@color/pribor_paper_deep" />
            <corners android:radius="2dp" />
        </shape>
    </item>

    <!-- lever, up -->
    <item
        android:width="22dp"
        android:height="14dp"
        android:top="7dp"
        android:gravity="top|center_horizontal">
        <shape android:shape="rectangle">
            <solid android:color="@color/pribor_signal" />
            <stroke
                android:width="1dp"
                android:color="@color/pribor_ink" />
            <corners android:radius="2dp" />
        </shape>
    </item>
</layer-list>
